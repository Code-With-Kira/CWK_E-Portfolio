# SDD-CWK-001 v1.0 — server-side configuration names.
# Populate values only in local ignored environment files or the deployment provider.
# Never commit real credentials.

# Resend — contact email delivery
RESEND_API_KEY=
CONTACT_EMAIL=

# Upstash Redis — persistent likes
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anonymous visitor identity protection
VISITOR_COOKIE_SECRET=
VISITOR_HASH_SECRET=

# Optional: only if the selected GitHub REST API operations require authentication
GITHUB_TOKEN=
